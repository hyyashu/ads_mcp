{
  "name": "ads-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inventory:validate": "tsx scripts/validate-inventory.ts",
    "inventory:matrix": "tsx scripts/generate-matrix.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p .data && drizzle-kit migrate",
    "tenant:create": "tsx scripts/create-tenant.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
