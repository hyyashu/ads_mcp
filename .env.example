# Encryption keyring for stored OAuth credentials: "<version>:<base64 of 32 bytes>[,<version>:<key>]". Generate: openssl rand -base64 32
ADS_MCP_KEYS=
# ADS_MCP_ACTIVE_KEY=1

# Postgres in production. Unset = embedded Postgres (PGlite) in .data/pglite (development only).
# DATABASE_URL=postgres://user:pass@host:5432/ads_mcp

PORT=8787
# Public https origin of this server. It is the OAuth issuer, and PUBLIC_URL + /mcp is the MCP resource that access tokens are bound to.
PUBLIC_URL=http://localhost:8787
NODE_ENV=development
# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Browser origins allowed to call /mcp (comma separated). Non-browser MCP clients send no Origin and are unaffected.
# ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# Rate limiting. "db" is shared across instances (required for more than one instance); "memory" is per instance.
RATE_LIMIT_STORE=db
# TENANT_RATE_BURST=60
# TENANT_RATE_PER_SEC=5
# ACCOUNT_RATE_BURST=20
# ACCOUNT_RATE_PER_SEC=2

# --- Connect Google Ads (OAuth, separate from MCP-client OAuth) ---
# Google Cloud OAuth client. API access levels (Explorer/Basic/Standard) attach to THIS Cloud project:
# developer tokens were sunset on 2026-09-09, so no developer token is used or sent.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# No default on purpose: choose a current Google Ads API version from Google's release notes.
# GOOGLE_ADS_API_VERSION=v26   (latest per release notes 2026-11; v23 sunsets Feb 2027)
# Redirect URI to register in Google Cloud: ${PUBLIC_URL}/connect/google/callback

# --- Connect Meta Ads ---
# META_APP_ID=
# META_APP_SECRET=
# META_API_VERSION=v26.0   (latest per Meta Graph API changelog, checked 2026-11-04)
# Redirect URI to register in the Meta app: ${PUBLIC_URL}/connect/meta/callback

# --- Optional: YouTube Data API key for video validation (validate_video) ---
# YOUTUBE_API_KEY=
